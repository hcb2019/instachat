# O aplicativo funciona sem credenciais quando DEMO_MODE=true.
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
OWNER_EMAIL=voce@example.com

# Supabase (use `pnpm db:start` para obter valores locais)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Meta — Instagram API with Instagram Login
META_APP_ID=
META_APP_SECRET=
# Segredo do aplicativo principal da Meta (Configurações do app → Básico).
# A Meta usa este valor para assinar webhooks e solicitações de exclusão.
META_WEBHOOK_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
# 32 bytes em base64: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# Endpoints internos e observabilidade
WORKER_SECRET=
OPENAI_API_KEY=
OPENAI_AUDIENCE_MODEL=gpt-5.6-terra
AI_MAX_COMMENTS_PER_RUN=2000
AI_MAX_DAILY_RUNS=2
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
